{
  "identifier": "default",
  "description": "Default capabilities for MidiMasterPro",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:write-files",
    "fs:read-files",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    }
  ]
}
